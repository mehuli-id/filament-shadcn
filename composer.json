{
    "name": "mehuli/filament-shadcn",
    "description": "Tema Filament bergaya shadcn/ui: token warna yang bisa dikustomisasi, gaya Vega/Nova/Maia/Lyra/Mira, halaman Tampilan, dan showcase semua komponen.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["filament", "filament-plugin", "filament-theme", "shadcn", "laravel"],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Mehuli\\FilamentShadcn\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mehuli\\FilamentShadcn\\FilamentShadcnServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
